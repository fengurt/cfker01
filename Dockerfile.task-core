FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=8790
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY services/task-core ./services/task-core
RUN chown -R node:node /app
USER node
EXPOSE 8790
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=20s CMD node -e "fetch('http://127.0.0.1:8790/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "services/task-core/server.mjs"]
