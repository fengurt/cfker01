ARG TARGETPLATFORM=linux/amd64
FROM --platform=$TARGETPLATFORM node:22-bookworm-slim

ARG COSCLI_SHA256=7165f2ae16c5f7ac495864c963ca574a76e04ec72680d7bc8a8eee3234d8cf91
ENV NODE_ENV=production \
    HOME=/home/node \
    PATH=/opt/tccli/bin:$PATH
WORKDIR /app

# The scanner imports a small production dependency set (for deterministic
# Ethereum name hashing). Keep its node_modules in this sidecar image rather
# than relying on the catalog image's build stage.
COPY package.json package-lock.json ./

RUN sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gh python3 python3-venv \
    && python3 -m venv /opt/tccli \
    && /opt/tccli/bin/pip install --no-cache-dir --index-url https://mirrors.cloud.tencent.com/pypi/simple tccli==3.1.126.1 \
    && curl -fsSL https://cosbrowser.cloud.tencent.com/software/coscli/coscli-linux-amd64 -o /usr/local/bin/coscli \
    && echo "${COSCLI_SHA256}  /usr/local/bin/coscli" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/coscli \
    && npm config set fetch-retries 5 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm ci --omit=dev \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/discover-assets.mjs scripts/scanner-loop.mjs scripts/sync-loop.sh ./scripts/
COPY scripts/lib/dns-probe.mjs scripts/lib/docker-runtime-metrics.mjs ./scripts/lib/
COPY config/discovery.json ./config/discovery.json
COPY src/generated/local-projects.json ./src/generated/local-projects.json
RUN mkdir -p /data/assets \
    && chown -R node:node /app /data/assets \
    && chmod 0755 ./scripts/sync-loop.sh
USER node
ENTRYPOINT ["./scripts/sync-loop.sh"]
