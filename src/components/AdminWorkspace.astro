---
const pageTitle = "资源运营中心 | TableAI Catalog";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/admin.css?v=20260712-2" />
    <link rel="stylesheet" href="/admin-visibility.css?v=20260712-2" />
    <link rel="stylesheet" href="/admin-compact.css?v=20260713-2" />
    <link rel="stylesheet" href="/admin-ops-v2.css?v=20260811-capacity-1" />
    <link rel="stylesheet" href="/admin-scanner.css?v=20260715-1" />
    <link rel="stylesheet" href="/admin-tasks.css?v=20260803-2" />
    <link rel="stylesheet" href="/admin-interactions.css?v=20260802-5" />
  </head>
  <body>
    <a class="skip" href="#admin-main" data-i18n="skip">跳到管理区</a>
    <header>
      <a href="/resources/" class="admin-brand"><span>T</span><span data-i18n="brand">TableAI 资源运营</span></a>
      <nav class="header-nav"><a href="/catalog/" data-i18n="publicCatalog">公开目录</a><button id="shortcut-help" class="shortcut-help" type="button" aria-haspopup="dialog" aria-keyshortcuts="?" aria-label="快捷键帮助"><kbd>?</kbd></button><button id="language" type="button">EN</button><div id="session-actions" hidden><span id="admin-role">系统管理员</span><button id="logout" type="button" data-i18n="logout">退出</button></div></nav>
    </header>
    <main id="admin-main">
      <section class="login-panel" id="login-panel">
        <form id="login-form">
          <p class="kicker">ADMIN / 管理员</p><h1 data-i18n="loginTitle">系统管理员登录</h1>
          <p data-i18n="loginHelp">使用手机号码和密码登录。可信设备会通过安全的 HttpOnly Cookie 保持登录 90 天，并在使用时自动续期。</p>
          <label><span data-i18n="phone">手机号码</span><input id="admin-phone" type="tel" inputmode="tel" autocomplete="username" required /></label>
          <label><span data-i18n="password">密码</span><input id="admin-password" type="password" autocomplete="current-password" required /></label>
          <p class="form-error" id="login-error" role="alert"></p><button class="primary" type="submit" data-i18n="login">登录</button>
        </form>
      </section>
      <section id="dashboard" hidden>
        <div class="admin-intro"><div><p class="kicker">RESOURCE OPS / 资源运营</p><h1 data-i18n="inventory">项目资源库</h1><p data-i18n="inventoryHelp">统一管理本机扫描、技能、Agent、仓库、部署与基准证据。</p></div><div class="intro-actions"><button id="manage-reviews" type="button">仓库审查</button><button class="primary" id="import-local" type="button" data-i18n="import">导入本机扫描</button></div></div>
        <nav class="workspace-tabs" aria-label="资源视图"><button id="manage-tasks" type="button" data-view="tasks" data-i18n="tasks">任务</button><button id="manage-projects" type="button" data-view="projects" data-i18n="projects">项目</button><button id="manage-servers" class="active" type="button" data-view="servers" data-i18n="resourceMonitoring">资源监控</button><button id="manage-repositories" type="button" data-view="repositories" data-i18n="repositories">仓库</button></nav>
        <section id="tasks-view" hidden>
          <div class="task-command-bar"><div class="task-metrics"><div><strong id="task-metric-open">0</strong><span data-i18n="openTasks">进行中</span></div><div><strong id="task-metric-due-soon">0</strong><span data-i18n="dueSoonTasks">7 天内到期</span></div><div><strong id="task-metric-unassigned">0</strong><span data-i18n="unassignedTasks">未分派</span></div><div><strong id="task-metric-value">¥0</strong><span data-i18n="expectedValue">预期收益</span></div></div><span id="task-realtime-status" class="task-realtime-status" data-state="offline" role="status">离线</span><button id="quick-task-open" class="primary" type="button" aria-keyshortcuts="Control+K Meta+K"><span data-i18n="newTask">新建任务</span><kbd>⌘ K</kbd></button></div>
          <div class="task-view-bar"><div class="task-view-switch" role="group" aria-label="任务视图"><button class="active" type="button" data-task-view="list" data-i18n="taskList">列表</button><button type="button" data-task-view="board" data-i18n="taskBoard">看板</button><button type="button" data-task-view="gantt" data-i18n="taskGantt">甘特图</button></div><div class="task-saved-views"><select id="task-saved-view" aria-label="保存的视图"><option value="" data-i18n="savedViews">保存的视图</option></select><input id="task-view-name" data-i18n-placeholder="viewName" placeholder="视图名称" /><button id="save-task-view" type="button" data-i18n="saveView">保存视图</button></div></div>
          <form id="task-filters" class="task-filters">
            <label class="task-search"><span data-i18n="search">搜索</span><input name="q" type="search" data-i18n-placeholder="taskSearch" placeholder="任务、编号或描述" /></label>
            <label><span data-i18n="status">状态</span><select name="status"><option value="">全部</option><option value="backlog">Backlog</option><option value="todo">Todo</option><option value="in_progress">In progress</option><option value="blocked">Blocked</option><option value="in_review">In review</option><option value="done">Done</option></select></label>
            <label><span data-i18n="projects">项目</span><span class="task-project-picker"><input type="search" data-project-picker data-i18n-placeholder="projectSearch" placeholder="搜索项目" list="task-project-options" autocomplete="off" /><input type="hidden" name="project" /></span></label>
            <label><span data-i18n="owner">负责人</span><select name="owner"><option value="">全部负责人</option></select></label>
            <label><span data-i18n="participant">对接人</span><select name="participant"><option value="">全部对接人</option></select></label>
            <label><span data-i18n="milestone">里程碑</span><select name="milestone"><option value="">全部里程碑</option></select></label>
            <label><span data-i18n="deliveryDomain">交付领域</span><input name="domain" placeholder="API / Infra / Design" /></label>
            <label><span data-i18n="sort">排序</span><select name="sort"><option value="updated">最近更新</option><option value="priority">优先级</option><option value="due">截止日期</option><option value="value">预期收益</option></select></label>
            <button id="reset-task-filters" type="button" data-i18n="resetFilters">重置</button>
          </form>
          <div id="task-notice" class="task-notice" role="status"></div>
          <div id="task-list-view" class="task-list"><div class="task-list-head"><span data-i18n="task">任务</span><span data-i18n="projectMilestone">项目 / 里程碑</span><span data-i18n="owner">负责人</span><span data-i18n="schedule">排期</span><span data-i18n="valueImpact">收益 / 价值</span></div><div id="task-list-rows"></div></div>
          <div id="task-board-view" class="task-board" hidden></div>
          <div id="task-gantt-view" class="task-gantt" hidden><div id="task-gantt-head" class="task-gantt-head"></div><div id="task-gantt-rows"></div></div>
          <div class="task-directories"><details class="task-directory"><summary data-i18n="peopleDirectory">人员、Agent 与对接人目录</summary><form id="task-person-form"><label><span data-i18n="type">类型</span><select name="kind"><option value="person">Person</option><option value="agent">Agent</option><option value="contact">Contact</option></select></label><label><span data-i18n="name">名称</span><input name="displayName" required /></label><label><span>Handle</span><input name="handle" /></label><button type="submit" data-i18n="addPerson">添加</button></form><div id="task-people-list" class="task-people-list"></div></details><details class="task-directory"><summary data-i18n="milestoneDirectory">项目里程碑</summary><form id="task-milestone-form"><label><span data-i18n="name">名称</span><input name="name" required /></label><label><span data-i18n="projects">项目</span><span class="task-project-picker"><input type="search" data-project-picker data-i18n-placeholder="projectSearch" placeholder="搜索项目" list="task-project-options" autocomplete="off" /><input type="hidden" name="projectId" /></span></label><label><span data-i18n="dueDate">目标日期</span><input name="targetAt" type="date" /></label><button type="submit" data-i18n="addMilestone">添加里程碑</button></form><div id="task-milestone-list" class="task-people-list"></div></details></div>
          <datalist id="task-project-options"></datalist>
        </section>
        <section id="projects-view" hidden>
        <div class="metrics"><div><strong id="metric-total">0</strong><span data-i18n="records">管理记录</span></div><div><strong id="metric-scan">0</strong><span data-i18n="discoveries">本机发现</span></div><div><strong id="metric-pinned">0</strong><span data-i18n="pinned">已置顶</span></div><div><strong id="metric-missing">0</strong><span data-i18n="missing">缺少描述</span></div></div>
        <form class="admin-filters instant-filters" id="project-filters">
          <label class="search"><span data-i18n="search">搜索</span><input name="q" type="search" data-i18n-placeholder="searchPlaceholder" placeholder="名称、来源或描述" /></label>
          <div class="filter-cluster" data-filter="type"><span data-i18n="type">类型</span><div class="toggle-group"><button type="button" data-value="project" aria-pressed="false">Project</button><button type="button" data-value="repository" aria-pressed="false">Repository</button><button type="button" data-value="skill" aria-pressed="false">Skill</button><button type="button" data-value="agent" aria-pressed="false">Agent</button></div></div>
          <label class="tag-filter"><span data-i18n="tag">标签</span><input name="tag" placeholder="cloudflare" /></label>
          <div class="filter-cluster" data-filter="platform"><span data-i18n="platform">平台</span><div class="toggle-group"><button type="button" data-value="local-filesystem" aria-pressed="false">Local</button><button type="button" data-value="github" aria-pressed="false">GitHub</button><button type="button" data-value="cloudflare" aria-pressed="false">Cloudflare</button><button type="button" data-value="tencent" aria-pressed="false">Tencent</button></div></div>
          <div class="filter-cluster" data-filter="status"><span data-i18n="status">状态</span><div class="toggle-group"><button type="button" data-value="draft" aria-pressed="false">Draft</button><button type="button" data-value="reviewed" aria-pressed="false">Reviewed</button><button type="button" data-value="published" aria-pressed="false">Published</button><button type="button" data-value="archived" aria-pressed="false">Archived</button></div></div>
          <div class="filter-cluster compact-cluster" data-filter="deployed"><span data-i18n="deployment">部署</span><div class="toggle-group"><button type="button" data-value="true" aria-pressed="false" data-i18n="deployed">已部署</button><button type="button" data-value="false" aria-pressed="false" data-i18n="notDeployed">未部署</button></div></div>
          <div class="filter-cluster compact-cluster" data-filter="pinned"><span data-i18n="view">视图</span><div class="toggle-group"><button type="button" data-value="true" aria-pressed="false" data-i18n="pinnedOnly">仅置顶</button></div></div>
          <label><span data-i18n="sort">排序</span><select name="sort"><option value="priority" data-i18n="prioritySort">运营优先</option><option value="deployment_desc" data-i18n="latestDeployment">最新部署</option><option value="backup_desc" data-i18n="latestBackup">最新备份</option><option value="pin" data-i18n="pinRank">置顶顺序</option><option value="updated_desc" data-i18n="sourceUpdate">最近更新</option><option value="scan_desc" data-i18n="lastScan">最近扫描</option><option value="name" data-i18n="name">名称</option></select></label>
        </form>
        <div class="notice" id="notice" role="status"></div>
        <div class="project-table" role="table" aria-label="Managed projects"><div class="table-head" role="row"><span data-i18n="resourcePath">资源 / 本地路径</span><span data-i18n="github">GitHub</span><span data-i18n="deploymentServerUrl">部署 / 服务器 / URL</span><span data-i18n="updated">更新时间</span><span data-i18n="operations">运营状态</span></div><div id="project-rows"></div></div>
        <div class="pagination"><button id="previous" type="button" data-i18n="previous">上一页</button><span id="page-label">1 / 1</span><button id="next" type="button" data-i18n="next">下一页</button></div></section>
        <section id="servers-view">
          <details id="source-status-disclosure" class="source-status-panel">
            <summary><span id="source-status-title" data-i18n="scanSources">自动扫描来源</span><span id="source-summary-stats" class="source-summary-stats">正在读取刷新状态…</span><span class="source-summary-toggle" data-i18n="expand">展开</span></summary>
            <div class="source-status-body"><div class="source-status-head"><p id="source-poll-label">正在读取刷新状态…</p><button id="scan-all-sources" type="button" data-i18n="refreshAll">立即刷新全部</button></div><div id="source-connector-list" class="source-connector-list" aria-live="polite"></div></div>
          </details>
          <div class="server-toolbar"><div class="server-view-summary"><div><strong id="server-total">0</strong><span data-i18n="servers">服务器</span></div><div><strong id="server-online">0</strong><span data-i18n="healthy">健康</span></div><div><strong id="server-incidents">0</strong><span data-i18n="incidents">未恢复事件</span></div><div><strong id="server-deployments">0</strong><span data-i18n="activeDeployments">部署项目</span></div><div><strong id="server-repositories">0</strong><span data-i18n="githubRepositories">GitHub 仓库</span></div></div><button id="run-monitor" type="button" data-i18n="runMonitor">立即检查</button></div>
          <details id="renewal-disclosure" class="renewal-disclosure"><summary><span>到期预警 / 最近到期资源</span><small>未来 90 天 · 已验证数据</small></summary><section class="expiring-resource-panel" aria-labelledby="expiring-resource-title"><div class="expiring-resource-heading"><div><p class="fleet-eyebrow">RENEWAL / 到期预警</p><h2 id="expiring-resource-title">最近到期资源</h2></div><p>显示已验证的服务器、注册商域名与链上名称；未确认到期日的资源不会被猜测。</p></div><div id="expiring-resource-list" class="expiring-resource-list" aria-live="polite"></div></section></details>
          <div id="monitor-status" class="monitor-status" role="status"></div>
          <section id="incident-inbox" class="incident-inbox" aria-labelledby="incident-inbox-title"><div class="incident-inbox-heading"><div><p class="fleet-eyebrow">INBOX / 事件</p><h2 id="incident-inbox-title">需要处理</h2></div><span id="incident-inbox-summary" class="incident-inbox-summary"></span></div><div id="incident-inbox-list" aria-live="polite"></div></section>
          <details id="resource-snapshot-disclosure" class="resource-snapshot-disclosure"><summary><span>资源快照与部署建议</span><small>Agent JSON</small></summary><section class="resource-snapshot-panel" aria-labelledby="resource-snapshot-title"><div><p class="fleet-eyebrow">RESOURCE SNAPSHOT / Agent 输入</p><h2 id="resource-snapshot-title">资源快照与部署建议</h2><p id="resource-snapshot-status">展开后读取最新快照。</p></div><div class="resource-snapshot-actions"><a id="resource-snapshot-api" href="/api/admin/v1/resource-snapshots/current" target="_blank" rel="noopener noreferrer">API JSON</a><button id="generate-resource-snapshot" type="button">立即生成</button><button id="copy-resource-snapshot" type="button">复制 JSON</button></div><pre id="resource-snapshot-preview" aria-live="polite"></pre></section></details>
          <section class="fleet-overview" aria-labelledby="fleet-overview-title">
            <div class="fleet-health-panel">
              <div class="fleet-panel-heading"><div><p class="fleet-eyebrow">FLEET / 运行概览</p><h2 id="fleet-overview-title">服务器可用性</h2></div><p id="fleet-health-summary" class="fleet-panel-note"></p></div>
              <div id="fleet-status-distribution" class="fleet-status-distribution" aria-label="服务器状态分布"></div>
              <div id="fleet-availability-grid" class="fleet-availability-grid" aria-label="服务器状态"></div>
            </div>
            <div class="fleet-capacity-panel">
              <div class="fleet-panel-heading"><div><p class="fleet-eyebrow">CAPACITY / 容量</p><h2>容量观察</h2></div><p id="fleet-capacity-summary" class="fleet-panel-note"></p></div>
              <div id="fleet-capacity-list" class="fleet-capacity-list" aria-label="服务器容量"></div>
            </div>
            <div class="fleet-coverage-panel">
              <div class="fleet-panel-heading"><div><p class="fleet-eyebrow">COVERAGE / 覆盖</p><h2>项目与服务关联</h2></div><p id="fleet-coverage-summary" class="fleet-panel-note"></p></div>
              <dl id="fleet-coverage-stats" class="fleet-coverage-stats"></dl>
            </div>
          </section>
          <section id="server-cost-panel" class="server-cost-panel" aria-labelledby="server-cost-title"><div class="fleet-panel-heading"><div><p class="fleet-eyebrow">COST / 成本与容量决策</p><h2 id="server-cost-title">账单与服务器建议</h2></div><p id="server-cost-summary" class="fleet-panel-note">读取腾讯云账单后显示实际费用；没有账单权限时不会估算价格。</p></div><div id="server-cost-grid" class="server-cost-grid" aria-live="polite"></div></section>
          <section class="infrastructure-resource-panel" aria-labelledby="infrastructure-resource-title">
            <div class="infrastructure-resource-heading"><div><p class="fleet-eyebrow">INFRASTRUCTURE / 优先资源</p><h2 id="infrastructure-resource-title">URL、DNS 与 COS 资源</h2></div><p>服务器按已登记部署数量由低到高排列，便于优先评估空闲容量。</p></div>
            <div class="infrastructure-resource-grid"><section aria-labelledby="infrastructure-pages-title"><h3 id="infrastructure-pages-title">Pages URL / 可用性</h3><div id="infrastructure-pages-assets" class="infrastructure-asset-list" aria-live="polite"></div></section><section aria-labelledby="infrastructure-cos-title"><h3 id="infrastructure-cos-title">COS Buckets</h3><div id="infrastructure-cos-assets" class="infrastructure-asset-list" aria-live="polite"></div></section><section aria-labelledby="infrastructure-dns-title"><h3 id="infrastructure-dns-title">全部 URL / DNS</h3><div id="infrastructure-dns-assets" class="infrastructure-asset-list" aria-live="polite"></div></section></div>
          </section>
          <section class="cloud-resource-section" aria-labelledby="cloud-resource-title">
            <div class="cloud-resource-heading"><div><p class="fleet-eyebrow">CLOUD INVENTORY / 云资产</p><h2 id="cloud-resource-title" data-i18n="cloudInventory">云资源清单</h2></div><p data-i18n="cloudInventoryHelp">统一筛选腾讯云、Cloudflare、GoDaddy 与链上域名资源。</p></div>
            <div class="asset-summary" id="cloud-summary"></div>
          <form class="asset-filters" id="cloud-filters"><label><span data-i18n="search">搜索</span><input name="q" type="search" placeholder="域名、Bucket、Worker" /></label><label><span data-i18n="provider">提供商</span><select name="provider"><option value="">全部</option><option value="tencent">Tencent</option><option value="cloudflare">Cloudflare</option><option value="godaddy">GoDaddy</option><option value="ens">ENS / Ethereum</option><option value="solana">Solana Name Service</option></select></label><label><span>Kind</span><select name="kind"><option value="">全部类型</option><option value="dns_domain">DNS Domain</option><option value="chain_domain">Chain Domain</option><option value="dns_record">DNS Record</option><option value="cos_bucket">COS Bucket</option><option value="cvm">CVM</option><option value="lighthouse">Lighthouse</option><option value="billing_account">Billing Account</option><option value="billing_resource">Billing Resource</option><option value="cbs_disk">CBS Disk</option><option value="tat_agent">TAT Agent</option><option value="server_runtime">Server Runtime</option><option value="runtime_service">Runtime Service</option><option value="runtime_container">Runtime Container</option><option value="edgeone_zone">EdgeOne</option><option value="worker">Worker</option><option value="pages_project">Pages</option><option value="d1_database">D1</option><option value="kv_namespace">KV</option><option value="r2_bucket">R2</option><option value="credential_status">Credential</option></select></label><label><span>可达性</span><select name="probe"><option value="">全部</option><option value="reachable">HTTPS 可达</option><option value="reachable_insecure">仅 HTTP</option><option value="client_error">客户端错误</option><option value="server_error">服务端错误</option><option value="unreachable">不可达</option><option value="dns_error">DNS 错误</option><option value="skipped_private">私网跳过</option><option value="pending">待检查</option></select></label><label><span data-i18n="region">地域</span><input name="region" /></label><label><span data-i18n="status">状态</span><input name="status" /></label><button type="submit" data-i18n="apply">筛选</button></form>
          <div class="asset-table"><div class="asset-head"><span>资源</span><span>类型</span><span>账号 / 地域</span><span>状态</span><span>最近检查</span></div><div id="cloud-assets"></div></div><div class="pagination"><button id="cloud-previous" type="button">上一页</button><span id="cloud-page-label">1 / 1</span><button id="cloud-next" type="button">下一页</button></div>
          </section>
          <div id="server-list" class="sub-list server-inventory"></div>
          <details class="server-create"><summary data-i18n="addServer">添加服务器</summary><div class="server-form editor-grid"><label><span data-i18n="name">名称</span><input id="server-name" /></label><label><span data-i18n="provider">提供商</span><input id="server-provider" /></label><label>IP<input id="server-ip" /></label><label><span data-i18n="architecture">架构</span><input id="server-arch" placeholder="amd64" /></label><label>CPU<input id="server-cpu" /></label><label>RAM MB<input id="server-memory" type="number" /></label><label>Disk GB<input id="server-disk" type="number" /></label><label>OS<input id="server-os" /></label><label><span data-i18n="dueDate">到期日期</span><input id="server-due" type="date" /></label><label>Public URL<input id="server-public-url" type="url" /></label><label>Health URL<input id="server-health-url" type="url" /></label></div><div class="dialog-actions"><button type="button" class="primary" id="save-server" data-i18n="saveServer">添加服务器</button></div></details>
        </section>
        <section id="repositories-view" hidden>
          <div class="asset-summary" id="repository-summary"></div>
          <form class="asset-filters" id="repository-filters"><label><span data-i18n="search">搜索</span><input name="q" type="search" placeholder="owner/repository 或本机路径" /></label><label><span data-i18n="provider">来源</span><select name="provider"><option value="">全部</option><option value="github">GitHub</option><option value="local">Local</option></select></label><label><span>Owner</span><input name="account" /></label><label><span data-i18n="status">状态</span><select name="status"><option value="">全部</option><option value="active">active</option><option value="available">available</option><option value="archived">archived</option><option value="stale">stale</option></select></label><button type="submit" data-i18n="apply">筛选</button></form>
          <div class="asset-table repository-table"><div class="asset-head"><span>仓库</span><span>来源</span><span>同步状态</span><span>分支 / SHA</span><span>最近更新</span></div><div id="repository-assets"></div></div><div class="pagination"><button id="repository-previous" type="button">上一页</button><span id="repository-page-label">1 / 1</span><button id="repository-next" type="button">下一页</button></div>
        </section>
      </section>
    </main>
    <dialog id="editor"><form method="dialog" id="editor-form"><div class="dialog-head"><div><p class="kicker">RESOURCE / 资源</p><h2 id="editor-title">Resource</h2><p id="editor-source"></p></div><button value="cancel" aria-label="Close">×</button></div><input type="hidden" id="editor-id" /><div class="tab-list" role="tablist"><button type="button" data-tab="overview" class="active" data-i18n="overview">概览</button><button type="button" data-tab="review">仓库审查</button><button type="button" data-tab="deployment" data-i18n="deployment">部署</button><button type="button" data-tab="backup" data-i18n="backup">备份</button><button type="button" data-tab="codebase" data-i18n="codebase">代码地图</button><button type="button" data-tab="notes" data-i18n="notes">加密笔记</button><button type="button" data-tab="benchmarks" data-i18n="benchmarks">基准发现</button></div>
      <section class="tab-panel active" data-panel="overview"><label><span data-i18n="description">描述</span><textarea id="editor-description" rows="6"></textarea></label><div class="editor-grid"><label><span data-i18n="status">状态</span><select id="editor-status"><option>draft</option><option>reviewed</option><option>published</option><option>archived</option></select></label><label><span data-i18n="visibility">可见性</span><select id="editor-visibility"><option>public</option><option>private</option></select></label><label><span data-i18n="tags">标签（逗号分隔）</span><input id="editor-tags" /></label><label><span data-i18n="pinRank">置顶顺序</span><input id="editor-rank" type="number" min="1" max="9999" /></label></div><label class="check"><input id="editor-pinned" type="checkbox" /><span data-i18n="pinProject">置顶此项目</span></label></section>
      <section class="tab-panel" data-panel="review"><div id="project-review" class="sub-list"></div><button type="button" id="request-project-review">请求增量审查</button></section>
      <section class="tab-panel" data-panel="deployment"><div id="deployment-list" class="sub-list"></div><div class="editor-grid"><label><span data-i18n="server">服务器</span><select id="deployment-server"></select></label><label><span data-i18n="environment">环境</span><input id="deployment-environment" value="production" /></label><label>URL<input id="deployment-url" type="url" /></label><label><span data-i18n="version">版本</span><input id="deployment-version" /></label></div><button type="button" id="save-deployment" data-i18n="saveDeployment">保存部署</button></section>
      <section class="tab-panel" data-panel="backup"><div id="backup-list" class="sub-list"></div><div class="editor-grid"><label>GitHub URL<input id="backup-url" type="url" /></label><label><span data-i18n="branch">分支</span><input id="backup-branch" value="main" /></label></div><button type="button" id="save-backup" data-i18n="saveBackup">保存备份仓库</button></section>
      <section class="tab-panel" data-panel="codebase"><label><span data-i18n="codebase">代码地图</span><textarea id="codebase-content" rows="16" class="code"></textarea></label><button type="button" id="save-codebase" data-i18n="saveEncrypted">加密保存</button></section>
      <section class="tab-panel" data-panel="notes"><label><span data-i18n="notes">加密 Markdown 笔记</span><textarea id="notes-content" rows="16" class="code"></textarea></label><button type="button" id="save-notes" data-i18n="saveEncrypted">加密保存</button></section>
      <section class="tab-panel" data-panel="benchmarks"><div id="benchmark-form"><label><span data-i18n="benchmarkQuery">查找基准</span><input id="benchmark-query" required /></label><button type="button" id="start-benchmark" data-i18n="discover">开始发现</button></div><div id="benchmark-list" class="sub-list"></div></section>
      <div class="dialog-actions"><button value="cancel" data-i18n="close">关闭</button><button type="button" class="primary" id="save-project" data-i18n="save">保存概览</button></div></form></dialog>
    <dialog id="reviews-dialog"><form method="dialog"><div class="dialog-head"><div><p class="kicker">REPOSITORY REVIEW</p><h2>低 Token 仓库审查</h2></div><button value="cancel">×</button></div><div id="review-summary" class="sub-list"></div><div class="dialog-actions"><button value="cancel">关闭</button><button type="button" id="start-incremental-review">请求增量扫描</button><button type="button" class="primary" id="start-full-review">请求全量扫描</button></div></form></dialog>
    <dialog id="quick-task-dialog" class="task-dialog quick-task-dialog">
      <form method="dialog" id="quick-task-form">
        <div class="dialog-head">
          <div><p class="kicker">TASK / 快捷输入</p><h2 data-i18n="newTask">新建任务</h2><p class="quick-task-intro" data-i18n="quickTaskIntro">先写清结果，其余信息可以稍后补充。</p></div>
          <button type="button" value="cancel" aria-label="Close">×</button>
        </div>
        <label class="quick-task-title"><span data-i18n="taskTitle">任务标题</span><input name="title" required maxlength="240" autocomplete="off" data-i18n-placeholder="quickTaskPlaceholder" placeholder="例如：完成资源监控告警接入" autofocus /></label>
        <div class="quick-task-section-head"><span data-i18n="taskDetailsOptional">补充信息</span><small data-i18n="optional">可选</small></div>
        <div class="task-form-grid"><label><span data-i18n="projects">项目</span><select name="projectId"><option value="">不关联项目</option></select></label><label><span data-i18n="owner">负责人</span><select name="ownerId"><option value="">暂不指派</option></select></label><label><span data-i18n="dueDate">截止日期</span><input name="dueAt" type="date" /></label><label><span data-i18n="priority">优先级</span><select name="priority"><option value="0">P0</option><option value="1">P1</option><option value="2" selected>P2</option><option value="3">P3</option><option value="4">P4</option></select></label><label><span data-i18n="expectedValue">预期收益</span><input name="expectedValue" type="number" min="0" step="0.01" placeholder="CNY" /></label><label><span data-i18n="strategicValue">战略价值</span><select name="strategicValue"><option value="">未评估</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label></div>
        <p id="quick-task-error" class="quick-task-error" role="alert" aria-live="assertive" hidden></p>
        <div class="dialog-actions quick-task-actions"><p class="quick-task-shortcuts"><kbd>Enter</kbd><span data-i18n="enterToCreate">创建</span><span aria-hidden="true">·</span><kbd>Esc</kbd><span data-i18n="escapeToClose">关闭</span></p><button type="button" value="cancel" data-i18n="close">关闭</button><button id="quick-task-submit" class="primary" type="submit"><span data-submit-label data-i18n="createTask">创建任务</span><kbd>↵</kbd></button></div>
      </form>
    </dialog>
    <dialog id="task-dialog" class="task-dialog"><form method="dialog" id="task-editor-form"><div class="dialog-head"><div><p id="task-editor-identifier" class="kicker">TASK</p><h2 id="task-editor-title">Task</h2></div><button value="cancel" aria-label="Close">×</button></div><input type="hidden" name="id" /><label><span data-i18n="taskTitle">任务标题</span><input name="title" required maxlength="240" /></label><label><span data-i18n="description">描述</span><textarea name="description" rows="5"></textarea></label><div class="task-form-grid"><label><span data-i18n="status">状态</span><select name="status"><option value="backlog">Backlog</option><option value="todo">Todo</option><option value="in_progress">In progress</option><option value="blocked">Blocked</option><option value="in_review">In review</option><option value="done">Done</option><option value="cancelled">Cancelled</option></select></label><label><span data-i18n="priority">优先级</span><select name="priority"><option value="0">P0</option><option value="1">P1</option><option value="2">P2</option><option value="3">P3</option><option value="4">P4</option></select></label><label><span data-i18n="projects">项目</span><select name="projectId"><option value="">不关联项目</option></select></label><label><span data-i18n="milestone">里程碑</span><select name="milestoneId"><option value="">无里程碑</option></select></label><label><span data-i18n="owner">负责人</span><select name="ownerId"><option value="">暂不指派</option></select></label><label><span data-i18n="deliveryDomain">交付领域</span><input name="deliveryDomain" /></label><label><span data-i18n="startDate">开始日期</span><input name="startAt" type="date" /></label><label><span data-i18n="dueDate">截止日期</span><input name="dueAt" type="date" /></label><label><span data-i18n="expectedValue">预期收益</span><input name="expectedValue" type="number" min="0" step="0.01" /></label><label><span data-i18n="confidence">置信度 %</span><input name="valueConfidence" type="number" min="0" max="100" /></label><label><span data-i18n="strategicValue">战略价值</span><select name="strategicValue"><option value="">未评估</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label></div><section class="task-relations"><div><h3 data-i18n="participants">参与者 / 对接人</h3><div id="task-participant-list"></div><div class="task-inline-form participant-form"><select id="task-participant-select"><option value="">选择参与者</option></select><select id="task-participant-role"><option value="collaborator">Collaborator</option><option value="counterpart">Counterpart</option><option value="reviewer">Reviewer</option><option value="agent">Agent</option></select><button id="add-task-participant" type="button" data-i18n="add">添加</button></div></div><div><h3 data-i18n="dependencies">前置依赖</h3><div id="task-dependency-list"></div><div class="task-inline-form"><select id="task-dependency-select"><option value="">选择前置任务</option></select><button id="add-task-dependency" type="button" data-i18n="add">添加</button></div></div><div><h3 data-i18n="comments">评论</h3><div id="task-comment-list"></div><div class="task-inline-form"><input id="task-comment-input" data-i18n-placeholder="commentPlaceholder" placeholder="添加进展或交付说明" /><button id="add-task-comment" type="button" data-i18n="add">添加</button></div></div></section><div class="dialog-actions"><button value="cancel" data-i18n="close">关闭</button><button class="primary" type="submit" data-i18n="save">保存概览</button></div></form></dialog>
    <dialog id="shortcut-dialog" class="shortcut-dialog"><form method="dialog"><div class="dialog-head"><div><p class="kicker">KEYBOARD / 键盘</p><h2 id="shortcut-dialog-title">快捷键</h2><p id="shortcut-dialog-help">无需离开键盘即可切换视图、搜索和新建任务。</p></div><button value="cancel" aria-label="关闭快捷键帮助">×</button></div><div id="shortcut-list" class="shortcut-list"></div><div class="dialog-actions"><button value="cancel">关闭</button></div></form></dialog>
