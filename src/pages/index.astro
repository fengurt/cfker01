---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
const entries = await getCollection("entries");
const articles = (await getCollection("articles")).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = entries.filter((entry) => entry.data.featured).slice(0, 6);
const counts = ["app", "skill", "agent", "benchmark"].map((type) => ({ type, count: entries.filter((entry) => entry.data.types.includes(type as never)).length }));
---
<BaseLayout schema={{"@context":"https://schema.org","@type":"CollectionPage","name":"TableAI Catalog","description":"Reviewed AI apps, skills, agents, benchmarks, and articles."}}>
  <section class="hero shell">
    <div><p class="eyebrow">Evidence-first AI directory</p><h1>Find the tools.<br />Check the sources.</h1><p class="hero-copy">A reviewed catalog of apps, skills, agents, benchmarks, and technical writing.</p><div class="actions"><a class="button" href="/catalog/">Browse catalog</a><a class="text-link" href="/our-work/">See our work</a></div></div>
    <div class="hero-index" aria-label="Catalog counts">{counts.map(({type,count}) => <a href={type === "benchmark" ? "/benchmarks/" : `/catalog/${type}/`}><strong>{count}</strong><span>{type}s</span></a>)}</div>
  </section>
  <section class="section shell"><div class="section-heading"><h2>Featured records</h2><p>Representative tools and standards, selected for practical relevance and traceable sources.</p></div><EntryList entries={featured} /></section>
  <section class="article-band"><div class="shell"><h2>Latest writing</h2><div class="article-grid">{articles.slice(0,3).map((article) => <article><p>{article.data.kind === "local" ? "TableAI article" : "External reading"}</p><h3><a href={`/articles/${article.id}/`}>{article.data.title}</a></h3><span>{article.data.summary}</span></article>)}</div><a class="text-link" href="/articles/">View all articles</a></div></section>
</BaseLayout>
