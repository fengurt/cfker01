<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tableai.local-scanner</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/scripts/local-scanner-agent.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WORKER_URL</key><string>https://g.ksamint.cn</string>
    <key>LOCAL_SCAN_ROOTS</key><string>/Users/af/cpro01;/Users/af/Documents</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ROOT__/.cache/local-scanner/launchd.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/.cache/local-scanner/launchd-error.log</string>
</dict>
</plist>
