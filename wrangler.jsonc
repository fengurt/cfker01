{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfker01",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin/*", "/v1/*", "/mcp", "/.well-known/mcp", "/health", "/status"]
  },
  "vars": {
    "APP_NAME": "cfker01",
    "ENVIRONMENT": "development",
    "STATUS_PAGE_TITLE": "cfker01 cloud status"
  },
  "d1_databases": [
    {
      "binding": "MGMT_DB",
      "database_name": "cfker01-mgmt",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MGMT_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "env": {
    "staging": {
      "name": "cfker01-staging",
      "vars": {
        "APP_NAME": "cfker01",
        "ENVIRONMENT": "staging",
        "STATUS_PAGE_TITLE": "cfker01 cloud status (staging)"
      },
      "d1_databases": [
        {
          "binding": "MGMT_DB",
          "database_name": "cfker01-mgmt-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "MGMT_KV",
          "id": "00000000000000000000000000000001"
        }
      ]
    },
    "production": {
      "name": "cfker01-production",
      "vars": {
        "APP_NAME": "cfker01",
        "ENVIRONMENT": "production",
        "STATUS_PAGE_TITLE": "cfker01 cloud status"
      },
      "d1_databases": [
        {
          "binding": "MGMT_DB",
          "database_name": "cfker01-mgmt-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "MGMT_KV",
          "id": "00000000000000000000000000000002"
        }
      ]
    }
  }
}
