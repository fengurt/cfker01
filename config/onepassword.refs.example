# Copy this file to .env.1password and replace every value with one exact op:// reference.
# Do not use item-title searches in automation: duplicate titles must be resolved explicitly.
ADMIN_TOKEN_REF=op://Private/TableAI Catalog/admin-token
API_KEY_SALT_REF=op://Private/TableAI Catalog/api-key-salt
CONTENT_ENCRYPTION_KEY_REF=op://Private/TableAI Catalog/content-encryption-key
ADMIN_PHONE_REF=op://Private/TableAI Catalog/admin-phone
ADMIN_PASSWORD_REF=op://Private/TableAI Catalog/admin-password
PERPLEXITY_API_KEY_REF=op://Private/TableAI Catalog/perplexity-api-key
X_BEARER_TOKEN_REF=op://Private/TableAI Catalog/x-bearer-token
MINIMAX_API_KEY_REF=op://Private/TableAI Catalog/minimax-api-key
GITHUB_TOKEN_REF=op://Private/TableAI Catalog/github-token
SEMANTIC_SCHOLAR_API_KEY_REF=op://Private/TableAI Catalog/semantic-scholar-api-key
# Cloudflare discovery requires a scoped API Token (not a Global API Key) and its account ID.
# Use the exact item and field reference after creating/verifying the token in 1Password.
CLOUDFLARE_API_TOKEN_REF=op://Private/TableAI Catalog/cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID_REF=op://Private/TableAI Catalog/cloudflare-account-id
# GoDaddy discovery uses a read-only Personal Access Token with domains.domain:read.
GODADDY_API_TOKEN_REF=op://Personal/TableAI Catalog/godaddy-api-token
GODADDY_ACCOUNT_ID_REF=op://Personal/TableAI Catalog/godaddy-account-id
# MCP skill publication key: API scopes must be read,skills:write only.
KSAMINT_MCP_WRITE_KEY_REF=op://Personal/TableAI Catalog/ksamint-mcp-write-api
